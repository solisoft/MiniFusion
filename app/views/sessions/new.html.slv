<main class="flex-1 flex items-start justify-center px-5 py-10 sm:py-16">
    <div class="sheet w-full max-w-md p-7 sm:p-9">
        <h1 class="text-4xl">Se connecter</h1>
        <p class="mt-2 text-graphite">Retrouvez vos plans là où vous les avez laissés.</p>

        <% if @error %>
            <p class="flash mt-6" role="alert" style="border-color:#b42318"><%= @error %></p>
        <% end %>

        <form method="post" action="/login" class="mt-7 space-y-5">
            <%- csrf_field() %>
            <div class="field">
                <label for="email">E-mail</label>
                <input id="email" name="email" type="email" autocomplete="email" required value="<%= @email %>" autofocus>
            </div>
            <div class="field">
                <label for="password">Mot de passe</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
                <p class="mt-1.5 text-sm"><a href="/password/forgot">Mot de passe oublié ?</a></p>
            </div>
            <button type="submit" class="btn btn-solid w-full">Se connecter</button>
        </form>

        <div class="mt-8 pt-6 border-t border-line">
            <p class="text-graphite">Pour essayer sans s'inscrire : un compte partagé, déjà garni de pièces d'exemple.</p>
            <form method="post" action="/login/demo" class="mt-3">
                <%- csrf_field() %>
                <button type="submit" class="btn btn-line w-full">Essayer avec le compte de démo</button>
            </form>
        </div>

        <p class="mt-7 text-graphite">Pas encore de compte ? <a href="/signup">Créer un compte</a></p>
    </div>
</main>
