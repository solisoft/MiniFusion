<main class="flex-1 flex items-start justify-center px-5 py-10 sm:py-16">
    <div class="sheet w-full max-w-md p-7 sm:p-9">
        <h1 class="text-4xl">Nouveau mot de passe</h1>
        <% if @valid %>
            <% if @error %><p class="flash mt-6" role="alert" style="border-color:#b42318"><%= @error %></p><% end %>
            <form method="post" action="/password/reset/<%= @token %>" class="mt-7 space-y-5">
                <%- csrf_field() %>
                <div class="field">
                    <label for="password">Nouveau mot de passe</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" autofocus aria-describedby="password-hint">
                    <p class="text-sm text-graphite mt-1" id="password-hint">8 caractères au moins.</p>
                </div>
                <button type="submit" class="btn btn-solid w-full">Enregistrer le mot de passe</button>
            </form>
        <% else %>
            <p class="mt-4 text-graphite">Ce lien n'est plus valable : il a expiré ou a déjà servi.</p>
            <p class="mt-6"><a href="/password/forgot" class="btn btn-line">Demander un nouveau lien</a></p>
        <% end %>
    </div>
</main>
